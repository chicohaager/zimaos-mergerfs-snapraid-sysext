# Static SnapRAID build. Produces a fully static binary (ldd -> "not a dynamic
# executable") so it does not depend on the ZimaOS libc. Multi-stage: the final
# `export` stage is FROM scratch so `buildx -o type=local` drops just the binary.
#
# Build per arch via build-snapraid.sh (uses buildx --platform).

FROM debian:bookworm AS build
ARG SNAPRAID_VERSION=14.5
# Pinned SHA256 of the SnapRAID source tarball (supply-chain integrity). Bump together
# with SNAPRAID_VERSION; a mismatch (tampered/MITM'd/changed asset) fails the build.
ARG SNAPRAID_SHA256=ccbbf089134a2963147aeaa535911ad1868a2786daf54786d633837d4130da54
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates wget automake autoconf libtool pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN wget -O snapraid.tar.gz \
        "https://github.com/amadvance/snapraid/releases/download/v${SNAPRAID_VERSION}/snapraid-${SNAPRAID_VERSION}.tar.gz" \
    && echo "${SNAPRAID_SHA256}  snapraid.tar.gz" | sha256sum -c - \
    && tar -xzf snapraid.tar.gz \
    && cd "snapraid-${SNAPRAID_VERSION}" \
    && ./configure LDFLAGS="-static" \
    && make -j"$(nproc)" \
    && cp snapraid /snapraid \
    && echo "--- ldd check (expect: not a dynamic executable) ---" \
    && (ldd /snapraid || true) \
    && ./snapraid --version

FROM scratch AS export
COPY --from=build /snapraid /snapraid
