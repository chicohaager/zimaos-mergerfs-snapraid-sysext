[Unit]
Description=Ensure mergerfs pool started after sysext merge (boot-race guard)
# Same lesson as the ZimaOS tailscale/cron sysext modules: the WantedBy symlink
# can resolve before systemd-sysext.service finishes merging. start-pool.sh is
# idempotent (no-op if already mounted), so this is a safe fallback. It also waits
# for APP_DIR's config itself, so a late AppData disk is covered by both paths.
After=systemd-sysext.service
Wants=systemd-sysext.service

[Service]
Type=oneshot
# Wait up to 60s for the sysext merge to complete before starting the pool. The signal
# is the pool's own script, which only this sysext ships — NOT /usr/bin/mergerfs or
# /usr/bin/snapraid, which the ZimaOS base also provides (snapraid since 1.8.1). Only
# call systemctl start once merged; if it never merges, exit 0 (no false failure).
ExecStart=/bin/sh -c 'for i in $(seq 1 60); do [ -x /usr/lib/mergerfs-snapraid/start-pool.sh ] && exec systemctl start mergerfs-pool.service; sleep 1; done; echo "sysext not merged after 60s — pool not started"; exit 0'
