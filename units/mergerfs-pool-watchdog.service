[Unit]
Description=Ensure mergerfs pool started after sysext merge (boot-race guard)
# Same lesson as the ZimaOS tailscale/cron sysext modules: the WantedBy symlink
# can resolve before systemd-sysext.service finishes merging. start-pool.sh is
# idempotent (no-op if already mounted), so this is a safe fallback.
After=systemd-sysext.service
Wants=systemd-sysext.service

[Service]
Type=oneshot
# Wait up to 60s for the sysext merge to complete before starting the pool. The signal
# is /usr/bin/snapraid (sysext-only) — NOT /usr/bin/mergerfs, which the ZimaOS base
# always provides as a stale v1.5.4 and would trip us into starting too early. Only
# call systemctl start once merged; if it never merges, exit 0 (no false failure).
ExecStart=/bin/sh -c 'for i in $(seq 1 60); do [ -x /usr/bin/snapraid ] && exec systemctl start mergerfs-pool.service; sleep 1; done; echo "sysext not merged after 60s — pool not started"; exit 0'
