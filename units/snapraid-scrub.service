[Unit]
OnFailure=mergerfs-snapraid-alert@%n.service
Description=SnapRAID scrub (ZimaOS)
ConditionPathExists=/usr/bin/snapraid
# No condition on snapraid.conf: APP_DIR is configurable and may be on a late disk;
# the script fails loudly (instead of skipping silently) when the config is absent.
RequiresMountsFor=/DATA

[Service]
Type=oneshot
Nice=15
IOSchedulingClass=idle
ExecStart=/usr/lib/mergerfs-snapraid/snapraid-scrub.sh
